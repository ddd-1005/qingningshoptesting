# ===== 被测服务 =====
# 不填则使用 conftest.py 自动拉起的临时服务（推荐，什么都不用配）
# MINIMALL_BASE_URL=http://127.0.0.1:8000
# MINIMALL_UI_URL=http://127.0.0.1:8000
MINIMALL_TIMEOUT=10

# ===== 浏览器 =====
# edge / chrome / firefox
MINIMALL_BROWSER=edge
# 本地调试想看着浏览器跑，把它改成 false
MINIMALL_HEADLESS=true

# ===== 测试账号 =====
MINIMALL_USER=test01
MINIMALL_PWD=123456
